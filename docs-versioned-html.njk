---
# A person who opens a versioned address in a browser (a refusal's `docs` link is one) lands on today's page; the
# versions differ only in the markdown an AI reads.
pagination:
  data: collections.versionedPages
  size: 1
  alias: item
permalink: "/docs/v/{{ item.version.version }}/{{ item.doc.data.slug }}/"
eleventyExcludeFromCollections: true
---
{% set to = "/docs/" + item.doc.data.slug + "/" %}{% set md = item.doc.data.slug | versionedMd(item.version) %}<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ item.doc.data.title }} &mdash; Parachute {{ item.version.version }}</title>
    <meta http-equiv="refresh" content="0; url={{ to }}">
    <link rel="canonical" href="{{ site.origin }}{{ to }}">
    <link rel="alternate" type="text/markdown" href="{{ md }}">
    <meta name="robots" content="noindex">
    <script>location.replace({{ to | dump | safe }} + location.hash);</script>
</head>
<body>
    <p>{{ item.version.note }} <a href="{{ to }}">{{ item.doc.data.title }}</a> · <a href="{{ md }}">as markdown, for {{ item.version.version }}</a></p>
</body>
</html>
